{
  "manifest_version": 3,
  "name": "划词解释 · Word Explainer",
  "version": "2.5.10",
  "description": "多语言划词 AI 解释、拼写检查、朗读、PDF、区域 OCR 与生词整理工具",
  "permissions": ["activeTab", "storage", "offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "划词解释"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "打开划词解释，粘贴文字快速翻译"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["positioning.js", "output-formatting.js", "shortcuts.js", "theme.js", "content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popover.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
